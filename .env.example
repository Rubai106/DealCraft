# DealCraft backend — copy to .env (never commit .env)
PORT=3000

# Public base URL (https) used for every link DealCraft puts in an SMS,
# the ResolvePack PDF and WorkPassport pages. Set this on any deployed
# server (e.g. PUBLIC_BASE_URL=https://dealcraft.example.com) — without
# it, links are built from the request Host header, which must not be
# trusted behind a proxy. Local dev may leave it unset.
# PUBLIC_BASE_URL=https://dealcraft.example.com

# Reverse proxy: set TRUST_PROXY=true (or a hop count, e.g. 1) when a
# proxy / PaaS is in front, so the rate limiter keys on the real client
# IP from X-Forwarded-For instead of the proxy's socket address. Leave
# unset for direct (non-proxied) runs.
# TRUST_PROXY=true

# AppLink mode: 'sandbox' (default) or 'live'.
# Sandbox: no real SMS/OTP is sent. Codes are delivered by the sandbox
# SMS path only and NEVER appear in an API response body — unless
# TEST_MODE=true (see below), which exists solely so the automated
# regression suite can read the codes it needs.
APPLINK_MODE=sandbox

# Live mode — real AppLink API (https://api.applink.com.bd, docs at
# https://dev.applink.com.bd/docs). Same host for sandbox and live; there
# is no separate sandbox base URL.
# APPLINK_APP_ID = applicationId from your AppLink portal application.
# APPLINK_PASSWORD = the app's API key (AppLink calls it "password"),
#   emailed after your application is approved. Your AppLink application
#   exists and is Pending Approval; leave these blank until the API key
#   arrives.
APPLINK_APP_ID=
APPLINK_PASSWORD=
# Optional: override the API host (default https://api.applink.com.bd).
# Only set this if AppLink tells you to use a different host.
APPLINK_BASE_URL=
# Optional: template text sent with a live OTP SMS (AppLink generates the
# code itself; DealCraft never sees it). Optional delivery-report callback
# URL for SMS, if you run a public endpoint for it.
APPLINK_OTP_MESSAGE=
APPLINK_DELIVERY_REPORT_URL=

# Demo endpoints (GET /api/demo/script, POST /api/demo/seed and
# /api/demo/reset). They return 404 unless DEMO_MODE=true (in any
# environment, including NODE_ENV=production). Seeding is namespaced per
# visitor (visitor cookie / x-demo-visitor header) and can no longer
# touch other users' data. When DEALCRAFT_DEMO_TOKEN is set, the
# endpoints also require the same value as the x-demo-token header (or a
# demoToken body/query field); without a token, production allows any
# visitor to demo, while non-production allows loopback requests only.
# To let visitors use "See the demo" on a deployed server, set
# DEMO_MODE=true and leave DEALCRAFT_DEMO_TOKEN unset; set a token only
# to restrict the demo endpoints to its holders.
# DEMO_MODE=true
# DEALCRAFT_DEMO_TOKEN=change-this-to-a-random-string
DEALCRAFT_DEMO_TOKEN=

# TEST_MODE — TEST ONLY. When exactly 'true', sandbox OTP values are
# included in API response bodies so the automated regression suite
# (tests/regression/run-demo.mjs) can drive the demo end-to-end. Default
# OFF: with the flag unset, no OTP value ever appears in any response
# body. NEVER enable on a shared, demo or production server — it would
# leak login and confirmation codes to anyone who can call the API.
# TEST_MODE=true
