# DealCraft backend — copy to .env (never commit .env)
PORT=3000

# AppLink mode: 'sandbox' (default) or 'live'.
# Sandbox: no real SMS/OTP is sent; codes are returned labelled SANDBOX.
APPLINK_MODE=sandbox

# Live mode — real AppLink API (https://api.applink.com.bd, docs at
# https://dev.applink.com.bd/docs). Same host for sandbox and live; there
# is no separate sandbox base URL.
# APPLINK_APP_ID = applicationId from your AppLink portal application.
# APPLINK_PASSWORD = the app's API key (AppLink calls it "password"),
#   emailed after your application is approved. Your AppLink application
#   exists and is Pending Approval; leave these blank until the API key
#   arrives.
APPLINK_APP_ID=
APPLINK_PASSWORD=
# Optional: override the API host (default https://api.applink.com.bd).
# Only set this if AppLink tells you to use a different host.
APPLINK_BASE_URL=
# Optional: template text sent with a live OTP SMS (AppLink generates the
# code itself; DealCraft never sees it). Optional delivery-report callback
# URL for SMS, if you run a public endpoint for it.
APPLINK_OTP_MESSAGE=
APPLINK_DELIVERY_REPORT_URL=

# Demo endpoints (POST /api/demo/seed and /api/demo/reset) wipe the whole
# database. They return 404 when NODE_ENV=production. Outside production,
# setting DEALCRAFT_DEMO_TOKEN requires the same value as the x-demo-token
# header (or a demoToken body/query field) to use them.
# DEALCRAFT_DEMO_TOKEN=change-this-to-a-random-string
DEALCRAFT_DEMO_TOKEN=

SESSION_SECRET=change-me-in-production
